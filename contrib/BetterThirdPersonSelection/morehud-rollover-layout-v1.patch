+void SelectionWidget::UpdateMoreHUDRolloverLayout()
+{
+	std::lock_guard lock(m_manipulateMoreHUD);
+
+	if (!CachedAhzWidget.IsObject() || !CachedWidgetMenu || !CachedWidgetMenu->uiMovie)
+		return;
+
+	auto rect = SelectionWidgetMenu::GetMenuRect(CachedWidgetMenu.get());
+	auto rectWidth = rect.right - rect.left;
+	auto rectHeight = rect.bottom - rect.top;
+	if (rectWidth <= 0.0f || rectHeight <= 0.0f)
+		return;
+
+	auto widgetPos = GetWidgetPos();
+	auto widgetSize = GetWidgetSize();
+	double scale = OrigMCSize.x != 0.0f ? widgetSize.x / OrigMCSize.x : widgetSize.x / 100.0f;
+	double alpha = GetWidgetCurrentAlpha() / 100.0;
+	bool visible = SelectionWidgetMenu::IsVisible && FadeMode != FADED;
+
+	RE::GFxValue args[5]{
+		(widgetPos.x - rect.left) / rectWidth,
+		(widgetPos.y - rect.top) / rectHeight,
+		scale,
+		alpha,
+		visible
+	};
+
+	RE::GFxValue result;
+	if (CachedAhzWidget.Invoke("SetExternalRolloverLayout", &result, args, 5))
+	{
+		MoreHUDRolloverLayoutActive = true;
+
+		// Retain BTPS's progress circle while moreHUD renders the authoritative
+		// rollover text, information, activation button, and icon substitutions.
+		CachedActivateText.SetMember("_visible", false);
+		CachedGrayBar.SetMember("_visible", false);
+		CachedInfoText.SetMember("_visible", false);
+		CachedActivateButton.SetMember("_visible", false);
+	}
+}
+
+void SelectionWidget::ClearMoreHUDRolloverLayout()
+{
+	std::lock_guard lock(m_manipulateMoreHUD);
+	if (CachedAhzWidget.IsObject())
+		CachedAhzWidget.Invoke("ClearExternalRolloverLayout");
+
+	MoreHUDRolloverLayoutActive = false;
+}
